# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored: never commit real keys.

# --- AI student (OpenAI) ---
OPEN_API=
# Optional: which model to use (default gpt-4o-mini)
OPENAI_MODEL=

# --- Marking (n8n Mark Session workflow) ---
# Optional overrides (leave blank for the defaults)
MARK_SESSION_URL=
MARK_SESSION_NICKNAME=

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=
# Optional overrides (leave blank for the defaults)
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=
